# obsplane (services/observability) REST/WS base. No trailing slash.
NEXT_PUBLIC_OBS_API_BASE=http://localhost:8081

# Org the dashboard scopes every request to. Must be the org the token
# authenticates, or obsplane answers 403 (tenancy.Middleware) / WS close 4403.
NEXT_PUBLIC_OBS_ORG_ID=00000000-0000-0000-0000-000000000001

# Development bearer token. obsplane currently accepts a single dev token
# (tenancy.DevTokenAuthenticator) and is being hardened to JWT; either way the
# client just sends `Authorization: Bearer <token>`.
NEXT_PUBLIC_OBS_TOKEN=dev-token

# Browsers cannot set an Authorization header on a WebSocket handshake.
#   query        - append ?access_token=<token> (default; needs obsplane to read it)
#   subprotocol  - send Sec-WebSocket-Protocol: klaro-bearer,<token>
#                  (only works once obsplane echoes the subprotocol back)
#   none         - send no credential (local collector / unauthenticated dev)
NEXT_PUBLIC_OBS_WS_AUTH_MODE=query

# 1 = serve every screen from the in-repo mock transport instead of obsplane.
NEXT_PUBLIC_OBS_MOCK=1
