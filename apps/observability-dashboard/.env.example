# obsplane (services/observability) REST/WS base. No trailing slash.
# 8090 is what deploy/docker-compose.yml publishes.
NEXT_PUBLIC_OBS_API_BASE=http://localhost:8090

# Org the dashboard scopes every request to. Must be the org the token
# authenticates, or obsplane answers 403 (tenancy.Middleware) / WS close 4403.
NEXT_PUBLIC_OBS_ORG_ID=00000000-0000-0000-0000-000000000001

# Bearer token. obsplane verifies a signed HS256/RS256 JWT carrying org_id, role
# and exp (tenancy.JWTAuthenticator) - the same code path in development and in
# production. Mint a local one with:
#   node ../../services/observability/deploy/scripts/dev-token.mjs
# or let deploy/scripts/seed-dev.sh write this whole file for you.
NEXT_PUBLIC_OBS_TOKEN=

# How the live WebSocket carries that token. A browser cannot put an
# Authorization header on a handshake, so:
#   subprotocol  - Sec-WebSocket-Protocol: klaro-bearer,<token>  (default)
#   none         - send no credential (obsplane then answers 401, no socket)
# There is no query-parameter mode: a token in the URL lands in proxy access
# logs, browser history and Referer headers, and here that is a whole org.
NEXT_PUBLIC_OBS_WS_AUTH_MODE=subprotocol

# 1 = serve every screen from the in-repo mock transport instead of obsplane.
# Set to 0 once the stack is up (seed-dev.sh writes 0 into .env.local).
NEXT_PUBLIC_OBS_MOCK=1
